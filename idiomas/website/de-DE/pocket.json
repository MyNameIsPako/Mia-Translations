  "installSteps": {
    "iosSafari": "<p><strong>iPhone / iPad (Safari):</strong></p><ol><li>Tippe auf <strong>Teilen</strong> (Quadrat mit Pfeil).</li><li>Wähle <strong>Zum Home-Bildschirm</strong>.</li><li>Öffne <strong>Mia Pocket</strong> über das neue Symbol.</li></ol>",
    "iosChrome": "<p><strong>iPhone / iPad ({browser}):</strong></p><ol><li>Tippe auf <strong>Teilen</strong> in der Browserleiste.</li><li>Wähle <strong>Zum Home-Bildschirm</strong> oder <strong>Auf dem Home-Bildschirm</strong>.</li><li>Öffne <strong>Mia Pocket</strong> über das Symbol (nicht über den Browser-Tab).</li></ol><p>Falls es nicht klappt, öffne diese Seite in <strong>Safari</strong> und wiederhole die Schritte.</p>",
    "iosFirefox": "<p><strong>iPhone / iPad (Firefox):</strong></p><ol><li>Menü (≡) → <strong>Teilen</strong> oder <strong>Zum Home-Bildschirm</strong>.</li><li>Bestätige das Symbol von <strong>Mia Pocket</strong>.</li><li>Öffne die App über das Symbol auf dem Startbildschirm.</li></ol><p>Falls es nicht klappt, probiere <strong>Safari</strong>.</p>",
    "iosDefault": "<p><strong>iPhone / iPad:</strong></p><ol><li>Nutze <strong>Teilen</strong> → <strong>Zum Home-Bildschirm</strong>.</li><li>Öffne <strong>Mia Pocket</strong> über das neue Symbol.</li></ol><p>Empfohlen: <strong>Safari</strong>, Chrome oder Brave.</p>",
    "androidFirefox": "<p><strong>Android (Firefox):</strong></p><ol><li>Menü (⋮) → <strong>Installieren</strong> oder <strong>Zum Startbildschirm hinzufügen</strong>.</li><li>Öffne <strong>Mia Pocket</strong> über das Symbol, nicht über den Browser.</li></ol>",
    "androidSamsung": "<p><strong>Android (Samsung Internet):</strong></p><ol><li>Menü → <strong>Seite hinzufügen zu</strong> → <strong>Startbildschirm</strong> oder <strong>App installieren</strong>.</li><li>Öffne <strong>Mia Pocket</strong> über das neue Symbol.</li></ol>",
    "androidBrave": "<p><strong>Android (Brave):</strong></p><ol><li>Tippe auf <strong>App installieren</strong>, falls der Button erscheint.</li><li>Oder Menü → <strong>App installieren</strong> / <strong>Zum Startbildschirm hinzufügen</strong>.</li><li>Öffne <strong>Mia Pocket</strong> über das Symbol, nicht über Brave.</li></ol>",
    "androidEdge": "<p><strong>Android (Edge):</strong></p><ol><li>Menü (⋯) → <strong>App installieren</strong> oder <strong>Zum Startbildschirm hinzufügen</strong>.</li><li>Öffne <strong>Mia Pocket</strong> über das neue Symbol.</li></ol>",
    "androidOpera": "<p><strong>Android (Opera):</strong></p><ol><li>Menü → <strong>Zum Startbildschirm hinzufügen</strong> oder <strong>App installieren</strong>.</li><li>Öffne <strong>Mia Pocket</strong> über das neue Symbol.</li></ol>",
    "androidDefault": "<p><strong>Android (Chrome und andere):</strong></p><ol><li>Tippe auf <strong>App installieren</strong>, falls der Button erscheint.</li><li>Oder Menü (⋮) → <strong>App installieren</strong> / <strong>App installieren</strong>.</li><li>Öffne <strong>Mia Pocket</strong> über das Symbol, nicht über den Browser.</li></ol>"
  },
