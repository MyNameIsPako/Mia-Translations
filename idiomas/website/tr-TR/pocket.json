  "installSteps": {
    "iosSafari": "<p><strong>iPhone / iPad (Safari):</strong></p><ol><li><strong>Paylaş</strong>’a dokun (oklu kare).</li><li><strong>Ana Ekrana Ekle</strong>’yi seç.</li><li>Yeni ikondan <strong>Mia Pocket</strong>’ı aç.</li></ol>",
    "iosChrome": "<p><strong>iPhone / iPad ({browser}):</strong></p><ol><li>Tarayıcı çubuğunda <strong>Paylaş</strong>’a dokun.</li><li><strong>Ana Ekrana Ekle</strong> veya <strong>Ana ekrana</strong>’yı seç.</li><li>Tarayıcı sekmesinden değil, ikondan <strong>Mia Pocket</strong>’ı aç.</li></ol><p>Çalışmazsa bu sayfayı <strong>Safari</strong>’de açıp adımları tekrarla.</p>",
    "iosFirefox": "<p><strong>iPhone / iPad (Firefox):</strong></p><ol><li>Menü (≡) → <strong>Paylaş</strong> veya <strong>Ana Ekrana Ekle</strong>.</li><li><strong>Mia Pocket</strong> ikonunu onayla.</li><li>Ana ekrandaki ikondan uygulamayı aç.</li></ol><p>Çalışmazsa <strong>Safari</strong>’yi dene.</p>",
    "iosDefault": "<p><strong>iPhone / iPad:</strong></p><ol><li><strong>Paylaş</strong> → <strong>Ana Ekrana Ekle</strong>’yi kullan.</li><li>Yeni ikondan <strong>Mia Pocket</strong>’ı aç.</li></ol><p>Önerilen: <strong>Safari</strong>, Chrome veya Brave.</p>",
    "androidFirefox": "<p><strong>Android (Firefox):</strong></p><ol><li>Menü (⋮) → <strong>Yükle</strong> veya <strong>Ana ekrana ekle</strong>.</li><li>Tarayıcıdan değil, ikondan <strong>Mia Pocket</strong>’ı aç.</li></ol>",
    "androidSamsung": "<p><strong>Android (Samsung Internet):</strong></p><ol><li>Menü → <strong>Sayfayı ekle</strong> → <strong>Ana ekran</strong> veya <strong>Uygulamayı yükle</strong>.</li><li>Yeni ikondan <strong>Mia Pocket</strong>’ı aç.</li></ol>",
    "androidBrave": "<p><strong>Android (Brave):</strong></p><ol><li>Görünürse <strong>Uygulamayı yükle</strong>’ye dokun.</li><li>Veya menü → <strong>Uygulamayı yükle</strong> / <strong>Ana ekrana ekle</strong>.</li><li>Brave’den değil, ikondan <strong>Mia Pocket</strong>’ı aç.</li></ol>",
    "androidEdge": "<p><strong>Android (Edge):</strong></p><ol><li>Menü (⋯) → <strong>Uygulamayı yükle</strong> veya <strong>Ana ekrana ekle</strong>.</li><li>Yeni ikondan <strong>Mia Pocket</strong>’ı aç.</li></ol>",
    "androidOpera": "<p><strong>Android (Opera):</strong></p><ol><li>Menü → <strong>Ana ekrana ekle</strong> veya <strong>Uygulamayı yükle</strong>.</li><li>Yeni ikondan <strong>Mia Pocket</strong>’ı aç.</li></ol>",
    "androidDefault": "<p><strong>Android (Chrome ve diğerleri):</strong></p><ol><li>Görünürse <strong>Uygulamayı yükle</strong>’ye dokun.</li><li>Veya menü (⋮) → <strong>Uygulamayı yükle</strong> / <strong>Uygulamayı yükle</strong>.</li><li>Tarayıcıdan değil, ikondan <strong>Mia Pocket</strong>’ı aç.</li></ol>"
  },
