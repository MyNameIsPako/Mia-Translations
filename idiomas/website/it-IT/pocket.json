    "iosSafari": "<p><strong>iPhone / iPad (Safari):</strong></p><ol><li>Tocca <strong>Condividi</strong> (quadro con freccia).</li><li>Scegli <strong>Aggiungi a Home</strong>.</li><li>Apri <strong>Mia Pocket</strong> dalla nuova icona.</li></ol>",
    "iosChrome": "<p><strong>iPhone / iPad ({browser}):</strong></p><ol><li>Tocca <strong>Condividi</strong> nella barra del browser.</li><li>Scegli <strong>Aggiungi a Home</strong> o <strong>Nella schermata Home</strong>.</li><li>Apri <strong>Mia Pocket</strong> dall'icona (non dalla scheda del browser).</li></ol><p>Se non funziona, apri questa pagina in <strong>Safari</strong> e ripeti i passaggi.</p>",
    "iosFirefox": "<p><strong>iPhone / iPad (Firefox):</strong></p><ol><li>Menu (≡) → <strong>Condividi</strong> o <strong>Aggiungi a Home</strong>.</li><li>Conferma l'icona di <strong>Mia Pocket</strong>.</li><li>Apri l'app dall'icona nella schermata Home.</li></ol><p>Se non funziona, prova con <strong>Safari</strong>.</p>",
    "iosDefault": "<p><strong>iPhone / iPad:</strong></p><ol><li>Usa <strong>Condividi</strong> → <strong>Aggiungi a Home</strong>.</li><li>Apri <strong>Mia Pocket</strong> dalla nuova icona.</li></ol><p>Consigliato: <strong>Safari</strong>, Chrome o Brave.</p>",
    "androidFirefox": "<p><strong>Android (Firefox):</strong></p><ol><li>Menu (⋮) → <strong>Installa</strong> o <strong>Aggiungi a schermata Home</strong>.</li><li>Apri <strong>Mia Pocket</strong> dall'icona, non dal browser.</li></ol>",
    "androidSamsung": "<p><strong>Android (Samsung Internet):</strong></p><ol><li>Menu → <strong>Aggiungi pagina a</strong> → <strong>Schermata Home</strong> o <strong>Installa applicazione</strong>.</li><li>Apri <strong>Mia Pocket</strong> dalla nuova icona.</li></ol>",
    "androidBrave": "<p><strong>Android (Brave):</strong></p><ol><li>Tocca <strong>Installa app</strong> se compare il pulsante.</li><li>O menu → <strong>Installa applicazione</strong> / <strong>Aggiungi a schermata Home</strong>.</li><li>Apri <strong>Mia Pocket</strong> dall'icona, non da Brave.</li></ol>",
    "androidEdge": "<p><strong>Android (Edge):</strong></p><ol><li>Menu (⋯) → <strong>Installa applicazione</strong> o <strong>Aggiungi a schermata Home</strong>.</li><li>Apri <strong>Mia Pocket</strong> dalla nuova icona.</li></ol>",
    "androidOpera": "<p><strong>Android (Opera):</strong></p><ol><li>Menu → <strong>Aggiungi a schermata Home</strong> o <strong>Installa applicazione</strong>.</li><li>Apri <strong>Mia Pocket</strong> dalla nuova icona.</li></ol>",
    "androidDefault": "<p><strong>Android (Chrome e altri):</strong></p><ol><li>Tocca <strong>Installa app</strong> se compare il pulsante.</li><li>O menu (⋮) → <strong>Installa applicazione</strong> / <strong>Installa app</strong>.</li><li>Apri <strong>Mia Pocket</strong> dall'icona, non dal browser.</li></ol>"
