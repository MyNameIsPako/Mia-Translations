  "installSteps": {
    "iosSafari": "<p><strong>iPhone / iPad (Safari):</strong></p><ol><li>Tap <strong>Share</strong> (square with arrow).</li><li>Choose <strong>Add to Home Screen</strong>.</li><li>Open <strong>Mia Pocket</strong> from the new icon.</li></ol>",
    "iosChrome": "<p><strong>iPhone / iPad ({browser}):</strong></p><ol><li>Tap <strong>Share</strong> in the browser bar.</li><li>Choose <strong>Add to Home Screen</strong> or <strong>On Home Screen</strong>.</li><li>Open <strong>Mia Pocket</strong> from the icon (not from the browser tab).</li></ol><p>If that doesn't work, open this page in <strong>Safari</strong> and repeat the steps.</p>",
    "iosFirefox": "<p><strong>iPhone / iPad (Firefox):</strong></p><ol><li>Menu (≡) → <strong>Share</strong> or <strong>Add to Home Screen</strong>.</li><li>Confirm the <strong>Mia Pocket</strong> icon.</li><li>Open the app from the home screen icon.</li></ol><p>If that doesn't work, try <strong>Safari</strong>.</p>",
    "iosDefault": "<p><strong>iPhone / iPad:</strong></p><ol><li>Use <strong>Share</strong> → <strong>Add to Home Screen</strong>.</li><li>Open <strong>Mia Pocket</strong> from the new icon.</li></ol><p>Recommended: <strong>Safari</strong>, Chrome, or Brave.</p>",
    "androidFirefox": "<p><strong>Android (Firefox):</strong></p><ol><li>Menu (⋮) → <strong>Install</strong> or <strong>Add to Home screen</strong>.</li><li>Open <strong>Mia Pocket</strong> from the icon, not from the browser.</li></ol>",
    "androidSamsung": "<p><strong>Android (Samsung Internet):</strong></p><ol><li>Menu → <strong>Add page to</strong> → <strong>Home screen</strong> or <strong>Install app</strong>.</li><li>Open <strong>Mia Pocket</strong> from the new icon.</li></ol>",
    "androidBrave": "<p><strong>Android (Brave):</strong></p><ol><li>Tap <strong>Install app</strong> if the button appears.</li><li>Or menu → <strong>Install app</strong> / <strong>Add to Home screen</strong>.</li><li>Open <strong>Mia Pocket</strong> from the icon, not from Brave.</li></ol>",
    "androidEdge": "<p><strong>Android (Edge):</strong></p><ol><li>Menu (⋯) → <strong>Install app</strong> or <strong>Add to Home screen</strong>.</li><li>Open <strong>Mia Pocket</strong> from the new icon.</li></ol>",
    "androidOpera": "<p><strong>Android (Opera):</strong></p><ol><li>Menu → <strong>Add to Home screen</strong> or <strong>Install app</strong>.</li><li>Open <strong>Mia Pocket</strong> from the new icon.</li></ol>",
    "androidDefault": "<p><strong>Android (Chrome and others):</strong></p><ol><li>Tap <strong>Install app</strong> if the button appears.</li><li>Or menu (⋮) → <strong>Install app</strong> / <strong>Install app</strong>.</li><li>Open <strong>Mia Pocket</strong> from the icon, not from the browser.</li></ol>"
  },
