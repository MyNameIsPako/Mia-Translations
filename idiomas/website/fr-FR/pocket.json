  "installSteps": {
    "iosSafari": "<p><strong>iPhone / iPad (Safari) :</strong></p><ol><li>Appuie sur <strong>Partager</strong> (carré avec flèche).</li><li>Choisis <strong>Sur l’écran d’accueil</strong>.</li><li>Ouvre <strong>Mia Pocket</strong> depuis la nouvelle icône.</li></ol>",
    "iosChrome": "<p><strong>iPhone / iPad ({browser}) :</strong></p><ol><li>Appuie sur <strong>Partager</strong> dans la barre du navigateur.</li><li>Choisis <strong>Sur l’écran d’accueil</strong> ou <strong>Ajouter à l’écran d’accueil</strong>.</li><li>Ouvre <strong>Mia Pocket</strong> depuis l’icône (pas depuis l’onglet du navigateur).</li></ol><p>Si ça ne marche pas, ouvre cette page dans <strong>Safari</strong> et recommence.</p>",
    "iosFirefox": "<p><strong>iPhone / iPad (Firefox) :</strong></p><ol><li>Menu (≡) → <strong>Partager</strong> ou <strong>Sur l’écran d’accueil</strong>.</li><li>Confirme l’icône de <strong>Mia Pocket</strong>.</li><li>Ouvre l’app depuis l’icône sur l’écran d’accueil.</li></ol><p>Si ça ne marche pas, essaie avec <strong>Safari</strong>.</p>",
    "iosDefault": "<p><strong>iPhone / iPad :</strong></p><ol><li>Utilise <strong>Partager</strong> → <strong>Sur l’écran d’accueil</strong>.</li><li>Ouvre <strong>Mia Pocket</strong> depuis la nouvelle icône.</li></ol><p>Recommandé : <strong>Safari</strong>, Chrome ou Brave.</p>",
    "androidFirefox": "<p><strong>Android (Firefox) :</strong></p><ol><li>Menu (⋮) → <strong>Installer</strong> ou <strong>Ajouter à l’écran d’accueil</strong>.</li><li>Ouvre <strong>Mia Pocket</strong> depuis l’icône, pas depuis le navigateur.</li></ol>",
    "androidSamsung": "<p><strong>Android (Samsung Internet) :</strong></p><ol><li>Menu → <strong>Ajouter la page à</strong> → <strong>Écran d’accueil</strong> ou <strong>Installer l’application</strong>.</li><li>Ouvre <strong>Mia Pocket</strong> depuis la nouvelle icône.</li></ol>",
    "androidBrave": "<p><strong>Android (Brave) :</strong></p><ol><li>Appuie sur <strong>Installer l’app</strong> si le bouton apparaît.</li><li>Ou menu → <strong>Installer l’application</strong> / <strong>Ajouter à l’écran d’accueil</strong>.</li><li>Ouvre <strong>Mia Pocket</strong> depuis l’icône, pas depuis Brave.</li></ol>",
    "androidEdge": "<p><strong>Android (Edge) :</strong></p><ol><li>Menu (⋯) → <strong>Installer l’application</strong> ou <strong>Ajouter à l’écran d’accueil</strong>.</li><li>Ouvre <strong>Mia Pocket</strong> depuis la nouvelle icône.</li></ol>",
    "androidOpera": "<p><strong>Android (Opera) :</strong></p><ol><li>Menu → <strong>Ajouter à l’écran d’accueil</strong> ou <strong>Installer l’application</strong>.</li><li>Ouvre <strong>Mia Pocket</strong> depuis la nouvelle icône.</li></ol>",
    "androidDefault": "<p><strong>Android (Chrome et autres) :</strong></p><ol><li>Appuie sur <strong>Installer l’app</strong> si le bouton apparaît.</li><li>Ou menu (⋮) → <strong>Installer l’application</strong> / <strong>Installer l’app</strong>.</li><li>Ouvre <strong>Mia Pocket</strong> depuis l’icône, pas depuis le navigateur.</li></ol>"
  },
