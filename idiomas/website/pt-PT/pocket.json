  "installSteps": {
    "iosSafari": "<p><strong>iPhone / iPad (Safari):</strong></p><ol><li>Toca em <strong>Partilhar</strong> (quadrado com seta).</li><li>Escolhe <strong>Adicionar ao ecrã principal</strong>.</li><li>Abre o <strong>Mia Pocket</strong> pelo novo ícone.</li></ol>",
    "iosChrome": "<p><strong>iPhone / iPad ({browser}):</strong></p><ol><li>Toca em <strong>Partilhar</strong> na barra do browser.</li><li>Escolhe <strong>Adicionar ao ecrã principal</strong> ou <strong>No ecrã principal</strong>.</li><li>Abre o <strong>Mia Pocket</strong> pelo ícone (não pelo separador do browser).</li></ol><p>Se não funcionar, abre esta página no <strong>Safari</strong> e repete os passos.</p>",
    "iosFirefox": "<p><strong>iPhone / iPad (Firefox):</strong></p><ol><li>Menu (≡) → <strong>Partilhar</strong> ou <strong>Adicionar ao ecrã principal</strong>.</li><li>Confirma o ícone do <strong>Mia Pocket</strong>.</li><li>Abre a app pelo ícone no ecrã inicial.</li></ol><p>Se não funcionar, experimenta o <strong>Safari</strong>.</p>",
    "iosDefault": "<p><strong>iPhone / iPad:</strong></p><ol><li>Usa <strong>Partilhar</strong> → <strong>Adicionar ao ecrã principal</strong>.</li><li>Abre o <strong>Mia Pocket</strong> pelo novo ícone.</li></ol><p>Recomendado: <strong>Safari</strong>, Chrome ou Brave.</p>",
    "androidFirefox": "<p><strong>Android (Firefox):</strong></p><ol><li>Menu (⋮) → <strong>Instalar</strong> ou <strong>Adicionar ao ecrã inicial</strong>.</li><li>Abre o <strong>Mia Pocket</strong> pelo ícone, não pelo browser.</li></ol>",
    "androidSamsung": "<p><strong>Android (Samsung Internet):</strong></p><ol><li>Menu → <strong>Adicionar página a</strong> → <strong>Ecrã inicial</strong> ou <strong>Instalar aplicação</strong>.</li><li>Abre o <strong>Mia Pocket</strong> pelo novo ícone.</li></ol>",
    "androidBrave": "<p><strong>Android (Brave):</strong></p><ol><li>Toca em <strong>Instalar app</strong> se o botão aparecer.</li><li>Ou menu → <strong>Instalar aplicação</strong> / <strong>Adicionar ao ecrã inicial</strong>.</li><li>Abre o <strong>Mia Pocket</strong> pelo ícone, não pelo Brave.</li></ol>",
    "androidEdge": "<p><strong>Android (Edge):</strong></p><ol><li>Menu (⋯) → <strong>Instalar aplicação</strong> ou <strong>Adicionar ao ecrã inicial</strong>.</li><li>Abre o <strong>Mia Pocket</strong> pelo novo ícone.</li></ol>",
    "androidOpera": "<p><strong>Android (Opera):</strong></p><ol><li>Menu → <strong>Adicionar ao ecrã inicial</strong> ou <strong>Instalar aplicação</strong>.</li><li>Abre o <strong>Mia Pocket</strong> pelo novo ícone.</li></ol>",
    "androidDefault": "<p><strong>Android (Chrome e outros):</strong></p><ol><li>Toca em <strong>Instalar app</strong> se o botão aparecer.</li><li>Ou menu (⋮) → <strong>Instalar aplicação</strong> / <strong>Instalar app</strong>.</li><li>Abre o <strong>Mia Pocket</strong> pelo ícone, não pelo browser.</li></ol>"
