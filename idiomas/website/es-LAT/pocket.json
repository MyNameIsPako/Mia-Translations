  "installSteps": {
    "iosSafari": "<p><strong>iPhone / iPad (Safari):</strong></p><ol><li>Toca <strong>Compartir</strong> (cuadro con flecha).</li><li>Elige <strong>Agregar a pantalla de inicio</strong>.</li><li>Abre <strong>Mia Pocket</strong> desde el ícono nuevo.</li></ol>",
    "iosChrome": "<p><strong>iPhone / iPad ({browser}):</strong></p><ol><li>Toca <strong>Compartir</strong> en la barra del navegador.</li><li>Elige <strong>Agregar a pantalla de inicio</strong> o <strong>En pantalla de inicio</strong>.</li><li>Abre <strong>Mia Pocket</strong> desde el ícono (no desde la pestaña del navegador).</li></ol><p>Si no funciona, abre esta página en <strong>Safari</strong> y repite los pasos.</p>",
    "iosFirefox": "<p><strong>iPhone / iPad (Firefox):</strong></p><ol><li>Menú (≡) → <strong>Compartir</strong> o <strong>Agregar a pantalla de inicio</strong>.</li><li>Confirma el ícono de <strong>Mia Pocket</strong>.</li><li>Abre la app desde el ícono en la pantalla de inicio.</li></ol><p>Si no funciona, prueba con <strong>Safari</strong>.</p>",
    "iosDefault": "<p><strong>iPhone / iPad:</strong></p><ol><li>Usa <strong>Compartir</strong> → <strong>Agregar a pantalla de inicio</strong>.</li><li>Abre <strong>Mia Pocket</strong> desde el ícono nuevo.</li></ol><p>Recomendado: <strong>Safari</strong>, Chrome o Brave.</p>",
    "androidFirefox": "<p><strong>Android (Firefox):</strong></p><ol><li>Menú (⋮) → <strong>Instalar</strong> o <strong>Agregar a pantalla de inicio</strong>.</li><li>Abre <strong>Mia Pocket</strong> desde el ícono, no desde el navegador.</li></ol>",
    "androidSamsung": "<p><strong>Android (Samsung Internet):</strong></p><ol><li>Menú → <strong>Agregar página a</strong> → <strong>Pantalla de inicio</strong> o <strong>Instalar aplicación</strong>.</li><li>Abre <strong>Mia Pocket</strong> desde el ícono nuevo.</li></ol>",
    "androidBrave": "<p><strong>Android (Brave):</strong></p><ol><li>Toca <strong>Instalar app</strong> si aparece el botón.</li><li>O menú → <strong>Instalar aplicación</strong> / <strong>Agregar a pantalla de inicio</strong>.</li><li>Abre <strong>Mia Pocket</strong> desde el ícono, no desde Brave.</li></ol>",
    "androidEdge": "<p><strong>Android (Edge):</strong></p><ol><li>Menú (⋯) → <strong>Instalar aplicación</strong> o <strong>Agregar a pantalla de inicio</strong>.</li><li>Abre <strong>Mia Pocket</strong> desde el ícono nuevo.</li></ol>",
    "androidOpera": "<p><strong>Android (Opera):</strong></p><ol><li>Menú → <strong>Agregar a pantalla de inicio</strong> o <strong>Instalar aplicación</strong>.</li><li>Abre <strong>Mia Pocket</strong> desde el ícono nuevo.</li></ol>",
    "androidDefault": "<p><strong>Android (Chrome y otros):</strong></p><ol><li>Toca <strong>Instalar app</strong> si aparece el botón.</li><li>O menú (⋮) → <strong>Instalar aplicación</strong> / <strong>Instalar app</strong>.</li><li>Abre <strong>Mia Pocket</strong> desde el ícono, no desde el navegador.</li></ol>"
  },
